extends layout 


block content 
    div.contenedorPlantillaBuscar

        div.contenedorBuscar 

            form(action="/buscar", method="GET") 
                div.contenedorControlesFiltros

                    div.buscarTitulo
                        h2 Buscar por titulo:
                        input(type="text", name="titulo", value=valoresFiltrados ? valoresFiltrados.titulo : '')

                    div.buscarAutor
                        h2 Buscar por autor:
                        input(type="text", name="autor", value=valoresFiltrados ? valoresFiltrados.autor : '')

                    div.buscarEtiquetas
                        h2 Agregue 1 etiqueta para filtrar:
                        input(type="text", name="etiqueta", value=valoresFiltrados ? valoresFiltrados.etiquetas : '')
                        div.contenedorEtiquetasAgregadas 

                    div.buscarFechas
                        h2 Filtrar por fecha 
                        label(for="DesdeFecha") Antes de: 
                        input(type="date", name="DesdeFecha", value=valoresFiltrados ? valoresFiltrados.DesdeFecha : '')
                        label(for="HastaFecha") Despues de: 
                        input(type="date", name="HastaFecha", value=valoresFiltrados ? valoresFiltrados.HastaFecha : '')   

                div.contenedorBuscarFiltros
                    button(type="submit") Buscar
                    
                    if tieneFiltros 
                        a(href="/buscar") Limpiar

        div.contenedorPublicacionesBuscadas
            if publicaciones.length > 0
                each publicacion in publicaciones 
                    div.contenedorDePublicacionBuscada
                        a(href="/publicaciones/" + publicacion.idPublicacion)
                            if publicacion.Fotografia && publicacion.Fotografia[0]
                                img(src="data:image/png;base64," + publicacion.Fotografia[0].urlArchivo, alt="foto") 
            else 
                h1 NO HAY PUBLICACIONES
    


