extends layout 
include ./mixins/alert

block content 
    div.contenedorChats 
        div.contenedorChatsCargados 
            each chat in chats
                div.contenedorChatExistente
                    if chat.idAutorFoto == currentUser.id 
                        a(href="/chats/" + chat.idChat)= chat.interesado.nombreUsuario
                    else 
                        a(href="/chats/" + chat.idChat)= chat.vendedor.nombreUsuario

        div.contenedorMensajesChats
            if idChat 
                div.contenedorSuperiorMensajes 
                    each mensaje in mensajes
                        if mensaje.idUsuarioEmisor == currentUser.id 
                            div.mensajeChat.enviado 
                                p= mensaje.contenido 
                        else 
                            div.mensajeChat.recibido
                                p= mensaje.contenido
                

                div.campoEscribirChat
                    form(action="/chats/" + idChat + "/mensaje", method="POST")
                        input(type="text", name="contenido", placeholder="Escriba un mensaje")
                        button(type="submit") Enviar
            else 
                div.contenedorSuperiorMensajes
                    p SELECCIONA UN CHAT PARA CARGAR MENSAJES
    +alert(alert)




