extends layout 

block content 
    div.contenedorColeccionSeleccionada 
        h1= nombreColeccion 
        div.contenedorImagenesDeColeccion
            each publicacion in publicaciones
                a(href="/publicaciones/" + publicacion.idPublicacion).cuadroColeccionMostrada 
                    img(src='data:image/png;base64,' + publicacion.fotoPortada)





