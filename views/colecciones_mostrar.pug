extends layout 

block content 
    div.contenedorMostrarColecciones 
        h1 Colecciones Creadas 
        div.coleccionesCreadas 
            each coleccionCreada in colecciones
                a(href="/colecciones/" + coleccionCreada.idColeccion).cuadroColeccion 
                    h1 #{coleccionCreada.nombreColeccion}

    