extends layout 

block content 
    
    div.contenedorVistaDenuncia

        div.vistaDenunciaSuperior
            div.vistaDenunciaFoto
                if datosVista.tipo == 'FOTO'
                    img(src='data:image/jpeg;base64,' + datosVista.previaFoto)

            div.vistaDetallesDenuncia  
                p Denuncia de: #{datosVista.denunciante}
                if datosVista.tipo == 'COMENTARIO'
                    p Comentario: #{datosVista.textoComentario}
                p motivo: #{datosVista.motivo}
                p justificacion: 
                div.justificacionUsuarioDenuncia
                    p #{datosVista.justificacion}



        div.vistaDenunciaInferior
            form(action=`/denuncias/resolver/${datosVista.idDenuncia}` method="POST")
                input(type="text", name="observacionValidador" placeholder="aca observacion")
                div.accionesObservador
                    button(type="submit", name="decision", value="aceptar") aceptar denuncia
                    button(type="submit", name="decision", value="rechazar") rechazar denuncia





