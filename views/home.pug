extends layout 
include mixins/footer

block metadata 

block content 
    
    div.home
        h1.tituloInicio Inicio
        div.panelFotografias
            each publicacion, index in publicaciones
                    div.fotoMostrada
                        a(href="/publicaciones/" + publicacion.idPublicacion)
                            if fotosAgregadas[index]
                                img(src="data:image/png;base64," + fotosAgregadas[index], alt="")
        
    +footer

