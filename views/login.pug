extends layout 
include ./mixins/alert




block content 
    div.loginUsuario 
        h1 Iniciar Sesion 
        form(action="/auth/login", method="POST") 
            label(for="nombreUsuario") Ingrese nombre 
            input(id="nombreUsuario", type="text", name="nombreUsuario", value= formValues ? formValues.nombreUsuario : '')
            label(for="passwordUsuario") Ingrese contrasena
            input(id="passwordUsuario", type="password", name="password", value= formValues ? formValues.password : '')
            button(type="submit") Login
    +alert(alert)


