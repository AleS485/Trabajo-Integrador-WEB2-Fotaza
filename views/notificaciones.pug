extends layout 

block content 
    div.contenedorNotificaciones
        h1 Notificaciones
        if notificaciones.length == 0
            h2 No hay notificaciones 
        else 
            each notificacion in notificaciones
                div.notificacion 
                    p El usuario #{notificacion.usuarioEnvia.nombreUsuario} #{notificacion.contenidoNotificacion}
                    
                    if !notificacion.estadoLectura
                        form(action="/notificaciones/leer/" + notificacion.idNotificacion, method="POST")
                            button(type="submit") Marcar Leida 
                    else 
                        p Leida 
                    p= notificacion.fechaNotificacion.toLocaleDateString()
                    




