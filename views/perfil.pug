extends layout 



block content 
    div.perfil-contenedor
        div.perfil-info
            div.perfil-foto
                img(src=`data:image/png;base64,${fotoUsuario}`, alt="foto")
            
            div.perfil-datos-usuario
                p= usuario.nombreUsuario
                div.estadisticas
                    a(href=`/perfil/${usuario.idUsuario}/seguidores`) Seguidores: #{seguidores}
                    a(href=`/perfil/${usuario.idUsuario}/seguidos`) Seguidos: #{seguidos}
                if currentUser.id != usuario.idUsuario
                    if usuarioLoSigue 
                        form(action=`/perfil/${usuario.idUsuario}/dejarSeguir`, method="POST")
                            button.boton-dejarSeguir(type="submit") Seguido
                    else 
                        form(action=`/perfil/${usuario.idUsuario}/seguir`, method="POST")
                            button.boton-seguir(type="submit") Seguir
            
    

