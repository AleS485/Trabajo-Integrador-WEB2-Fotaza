extends layout 
include ./mixins/alert

block content
    div.contenedorPublicacion
        div.infoPublicacionGeneral
            h1.descripcion-publicacion-titulo= publicacion.titulo
            div.autorPublicacion
                a(href="/perfil/" + publicacion.idUsuario) #{publicacion.autor}
            p.descripcion-publicacion-texto= publicacion.descripcion 
            div.etiquetasPublicacion
                each etiqueta in publicacion.etiquetas
                    span= etiqueta
            p.descripcion-publicacion-fecha= publicacion.fecha
            div.seccionAccionesGenerales <!-- cambie por un a, recordar-->
                if currentUser.id != publicacion.idUsuario
                    a.boton-guardarPublicacion(href="/colecciones/guardar/" + publicacion.idPublicacion) Guardar Publicacion
                if currentUser.id == publicacion.idUsuario
                    form(action="/publicaciones/comentarios/estado/" + publicacion.idPublicacion, method="POST") 
                        button.boton-cerrar-comentarios(type="submit") Cerrar/Abrir Comentarios
                    a.boton-editar-publicacion(href="/publicaciones/editar/" + publicacion.idPublicacion) Editar Publicacion
                    form(action="/publicaciones/eliminar/" + publicacion.idPublicacion, method="POST") 
                        button.boton-borrar-publicacion(type="submit") Borrar Publicacion
        each foto in publicacion.fotos 
            div.bloque-tarjeta-foto
                div.seccionSuperior
                    div.divisorImagen
                        img(src="data:image/png;base64," + foto.urlArchivo , alt="Fotografia")
                    div.divisorInfo
                        h3 Comentarios de la imagen
                        div.seccionComentariosPublicacion
                            each comentario in foto.comentarios
                                div.comentario
                                    div.cabeceraComentario
                                        div.autorComentarioIndividual
                                            a(href="/perfil/" + comentario.idUsuario)= comentario.nombreUsuario
                                        div.accionesComentarioIndividual
                                            if currentUser.id == publicacion.idUsuario
                                                form(action="/publicaciones/comentarios/borrar/" + comentario.idComentario + "/" + publicacion.idPublicacion, method="POST")
                                                    button.boton-borrar(type="submit") Borrar
                                            a.boton-reportar-com(href="/denuncias/comentario/" + comentario.idComentario) Reportar                    
                                    div.cuerpoComentario
                                        p= comentario.texto
                                        p.mini= comentario.fecha
                        
                        if publicacion.isCerrado
                            h2.comentarios-cerrados COMENTARIOS CERRADOS
                        else
                            div.seccionComentar
                                form(action="/publicaciones/comentarios/agregar/" + publicacion.idPublicacion, method="POST")
                                    input(type="hidden" name="idFotografia" value=foto.idFotografia)
                                    input(type="text" name="comentario" placeholder="Escribe un comentario")
                                    button(type="submit") Comentar 
                div.seccionInferior
                    div.seccionValorizaciones
                        if currentUser.id != publicacion.idUsuario
                            p.valorar-texto-publicacion Valora esta imagen 
                            form(action="/publicaciones/valorar/" + publicacion.idPublicacion, method="POST")
                                input(type="hidden" name="idFotografia" value=foto.idFotografia)
                                each punto in [1, 2, 3, 4, 5]
                                    label.boton-texto-votar #{punto}
                                    input(type="radio" name="valoracionPublicacion" value=punto)
                                button.boton-votar(type="submit") Votar
                        div.datos-votos
                            p Valoracion promedio: #{foto.promedioValoraciones}
                            p Valoraciones totales: #{foto.cantidadValoraciones}
                    div.seccionReporteFoto
                        if currentUser.id != publicacion.idUsuario
                            form(action="/chats/interes/" + foto.idFotografia, method="POST") 
                                button.botonInteres(type="submit") Me interesa

                            a.boton-reportar(href="/denuncias/foto/" + foto.idFotografia) Reportar Imagen
    +alert(alert)