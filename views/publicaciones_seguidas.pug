extends layout 

block content 
    
    div.contenedorPublicacionesSeguidas
        h1 Publicaciones de gente que seguis 

        if publicaciones.length == 0
            h2 No hay publicaciones de usuarios que sigas
        else 
            div.contenedorParaDistintasFotos 
                each publicacion in publicaciones
                    div.contenedorDePublicacion
                        a(href=`/publicaciones/${publicacion.idPublicacion}`)
                            if publicacion.fotos && publicacion.fotos.length > 0
                                img(src=`data:image/jpeg;base64,${publicacion.fotos[0].urlArchivo}`, alt="foto") 

        
    




