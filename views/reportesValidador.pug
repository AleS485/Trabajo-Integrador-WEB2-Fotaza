extends layout 

block content 
    div.contenedorReportes 
        h1 Reportes Recibidos
        if denunciasVista.length > 0
            each reporte in denunciasVista
                a(href=`/denuncias/revisar/${reporte.idDenuncia}`) 
                    div.reporte 
                        p #{reporte.denunciante}
                        p #{reporte.motivo}
                        p #{reporte.fecha}








