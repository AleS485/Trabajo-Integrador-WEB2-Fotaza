extends layout 

block content 
    div.contenedorSeguidoresPerfil 
        h1 Seguidores 
        each seguidor in seguidores
            div.seguidorPerfil
                img(src="data:image/png;base64," + seguidor.fotoUsuario, alt="foto") 
                a(href="/perfil/" + seguidor.idUsuario)= seguidor.nombreUsuario 
            

