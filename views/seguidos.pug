extends layout 


block content 
    div.contenedorSeguidosPerfil 
        h1 Seguidos
        each seguido in seguidos
            div.seguidoPerfil
                img(src="data:image/png;base64," + seguido.fotoUsuario, alt="foto") 
                a(href="/perfil/" + seguido.idUsuario)= seguido.nombreUsuario 
    
    

